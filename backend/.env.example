# Copiar este archivo a ".env" (en el mismo directorio) y ajustar los valores.
# El archivo ".env" real nunca debe subirse al repositorio (ver .gitignore).

# --- PostgreSQL ---
POSTGRES_DB=practica2
POSTGRES_USER=practica2_user
POSTGRES_PASSWORD=cambia_esta_contrasena

# --- Backend / JWT ---
# Cadena larga y aleatoria (por ejemplo: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=cambia_este_secreto_por_uno_aleatorio_y_largo
JWT_EXPIRE_MINUTES=60
